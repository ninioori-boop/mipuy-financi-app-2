# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# (/node_modules is root-anchored, so functions/node_modules needs its own line)
/node_modules
functions/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright MCP — page snapshots record form field values (incl. passwords) verbatim
.playwright-mcp/
advisor-*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase admin / client export script
# Credentials are matched by PATTERN, not exact name: a key downloaded from the
# Firebase console arrives as finance-machine-a36e9-firebase-adminsdk-xxxxx.json,
# which the old exact-name rule did not cover.
service-account-key.json
*firebase-adminsdk*.json
*service-account*.json
*.key
firebase-debug.log
clients.md
clients.html
.export-clients.log
funnel-report.md
funnel-report.json
data-report.html
